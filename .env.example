# Contact form. Each message is saved to a Google Sheet and emailed. Either one is enough for the form
# to report success; with neither set, the form tells visitors to email directly.
# Setup steps for the sheet: docs/google-sheet-setup.md

# Google Sheet (Apps Script web app URL and the shared secret from the script)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in src/components/sites/sweandrew/data.ts.
CONTACT_TO_EMAIL=
# Sender. Needs a domain verified in Resend. Defaults to Resend's test sender, which can only deliver
# to the email of the Resend account owner.
CONTACT_FROM_EMAIL=

# Public origin for canonical URLs, sitemap and social images. Set when a custom domain is attached.
NEXT_PUBLIC_SITE_URL=
